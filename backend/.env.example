# Backend / deploy-time references (NOT committed with real values).
# DB credentials live in Secrets Manager; the Lambda only knows the ARN.
DB_SECRET_ARN=arn:aws:secretsmanager:eu-west-1:000000000000:secret:nepalaid/db-XXXXXX

# Used by ETL notebooks / loaders only (never by the mobile app):
RDS_HOST=your-rds-endpoint.eu-west-1.rds.amazonaws.com
RDS_PORT=5432
RDS_DB=nepalaid
RDS_USER=postgres
RDS_PASSWORD=
